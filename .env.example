# Postgres (same DB as screener or dedicated)
DATABASE_URL=postgresql://user:pass@localhost:5432/market

# Universe resolution (optional; defaults suit local dev)
# STRATEGY_SCREENER_URL=http://127.0.0.1:8000
# MARKET_DATABASE_URL=postgresql://user:pass@localhost:5432/market
# (Required for POST /admin/backtest-replay — reads ohlcv_1d)

# Slack (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Flattrade (when using Flattrade adapter)
# TRADING_FLATTRADE_USER=your_user_id
# TRADING_FLATTRADE_TOKEN=your_session_token
