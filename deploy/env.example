# Copied to deploy/.env by `deploy.sh init`, which also fills PGPASSWORD and the dashboard login.
# Everything below can stay blank for a first test: the terminal runs on synthetic prices (TERMINAL_MODE=demo).

# --- Postgres ---
PGUSER=market_user
PGPASSWORD=

# --- Public address. ":80" = http on the server's IP. A domain pointing at the server = automatic https. ---
SITE_ADDRESS=:80
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# --- Live prices: demo | flattrade. Flattrade needs today's session token every day. ---
TERMINAL_MODE=demo
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
FLATTRADE_USER_ID=
FLATTRADE_ACCOUNT_ID=
FLATTRADE_TOKEN=

# --- Fyers (daily candles). With USERNAME + PIN + TOTP_KEY the screener refreshes the token itself at 08:00 IST ---
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_USERNAME=
FYERS_PIN=
FYERS_TOTP_KEY=
FYERS_ACCESS_TOKEN=

# --- Paytm Money: written by `python -m broker_auth paytm --env-file deploy/.env` each morning ---
PAYTM_ACCESS_TOKEN=
PAYTM_READ_ACCESS_TOKEN=
PAYTM_PUBLIC_ACCESS_TOKEN=

# --- Optional ---
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=
TRADING_SLACK_WEBHOOK_URL=
TRADING_FLATTRADE_USER=
TRADING_FLATTRADE_TOKEN=
