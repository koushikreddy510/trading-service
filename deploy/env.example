# Trading Pipeline – EC2 / Cloud deployment
# Copy to deploy/.env and fill in values

# --- Postgres ---
PGUSER=market_user
PGPASSWORD=CHANGE_ME

# --- Fyers (for OHLCV, commodity data) ---
FYERS_CLIENT_ID=your_client_id
FYERS_SECRET_KEY=your_secret_key
FYERS_ACCESS_TOKEN=your_access_token

# --- Strategy-screener ---
OPENAI_API_KEY=sk-...

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
TRADING_SLACK_WEBHOOK_URL=

# --- Trading (Flattrade) ---
TRADING_FLATTRADE_USER=
TRADING_FLATTRADE_TOKEN=

# Optional overrides (docker-compose sets STRATEGY_SCREENER_URL / MARKET_DATABASE_URL for trading-service)
# STRATEGY_SCREENER_URL=http://strategy-screener:8000
# MARKET_DATABASE_URL=postgresql://market_user:pass@postgres:5432/market
