# Env comes from docker-compose (web service). The Workspace has no login of its own yet, and its Data
# screen can start scrapes, so everything sits behind one shared password.
{$SITE_ADDRESS::80} {
	encode gzip
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	handle /terminal/* {
		reverse_proxy trading-service:8001
	}
	# Job overview and run history (scheduler): open /scheduler/ui
	handle /scheduler/* {
		uri strip_prefix /scheduler
		reverse_proxy scheduler:8002
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
